# secrets — never commit these
*.env
.env
.env.*
.env.local
credentials*.yaml
credentials*.json
*.key
*.pem
secrets.*
*_token*
*_secret*
*_password*

# macos
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd

# outputs and logs
output/
outputs/
.work/
# the docs site as mkdocs builds it; github pages builds its own copy
site/
*.log
*.tmp
*.bak

# board db — holds card tokens' blast radius, never committed even from a local dev run
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# usage-watcher's transient live-resume pointer — overwritten per attempt, never meant to be
# version controlled
resume_session.md

# python
__pycache__/
*.pyc
.venv/

# editors
.vscode/
.idea/
*.swp
*.swo

# claude code — settings.local.json is machine-local permission grants, never shared
.claude/settings.local.json
# the maintainer's own working notes beside the shared playbook: personal workflow, never published
CLAUDE.local.md
# card worktrees - full repo copies the board cuts per card; ruff and git status reached into them
.claude/worktrees/

# ledgers live in a private repo; these are local symlinks into it
TASKS.jsonl
WORKLOG.md
dev_ledger/
